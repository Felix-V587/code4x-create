{
  "name": "code4x-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp run -r test",
    "check": "vp check",
    "harness:vp": "bash fixtures/vp-harness/run.sh",
    "ci:tier2": "node scripts/tier2-matrix.mjs",
    "ci:tier2:all": "node scripts/tier2-matrix.mjs --all",
    "ci:tier3": "bash scripts/tier3-smoke.sh",
    "docs:dev": "pnpm -C website dev",
    "docs:build": "pnpm -C website build",
    "docs:preview": "pnpm -C website preview",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
